# Optional: omit for Google-only demo with Discord offline.
DISCORD_BOT_TOKEN=
PORT=3000
HOST=127.0.0.1
FRONTEND_ORIGINS=http://localhost:8081,http://localhost:19006

# LOCAL single-user demo only. Register this exact Web OAuth client redirect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback
# Generate each independently with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# API key goes in Authorization: Bearer, never in URLs.
GOOGLE_DEMO_API_KEY=
# Exactly 64 hex characters. Keep stable to decrypt .data/google-tokens.enc.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Enable Gmail, Sheets, Drive APIs. drive.file only sees files created/opened
# with this app, not all Drive files. No picker is implemented in this demo.
